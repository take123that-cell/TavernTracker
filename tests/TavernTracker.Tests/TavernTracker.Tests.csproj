<Project Sdk="Microsoft.NET.Sdk">

  <!-- Plain console test runner, no test framework needed. Run with: dotnet run (from this folder) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Run on whatever .NET is installed (8, 9, 10...), not only .NET 8. -->
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/TavernTracker.Core/TavernTracker.Core.csproj" />
  </ItemGroup>

</Project>
